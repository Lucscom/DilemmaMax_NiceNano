// Dilemma Max - Right Side

#include "dilemma_max.dtsi"

&default_transform {
    col-offset = <6>;
};

&right_encoder {
    status = "okay";
};

// Procyon Trackpad (ATMXT336UD) via I2C1
// SDA=P0.22(pin4), SCL=P0.24(pin5), CHG=P0.06(pin1), Addr=0x4A
&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 22)>,
                    <NRF_PSEL(TWIM_SCL, 0, 24)>;
        };
    };
    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 22)>,
                    <NRF_PSEL(TWIM_SCL, 0, 24)>;
            low-power-enable;
        };
    };
};

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    trackpad: trackpad@4a {
        compatible = "microchip,maxtouch";
        reg = <0x4a>;
        chg-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
        sensor-width = <40>;
        sensor-height = <60>;
    };
};

/ {
    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
    };
};
