// Dilemma Max - Right Side

#include "dilemma_max.dtsi"
#include <input/processors.dtsi>

// Disable UART0 (uses P0.06 as TX) to free pin for CHG interrupt
&uart0 {
    status = "disabled";
};

&default_transform {
    col-offset = <6>;
};

&right_encoder {
    status = "okay";
};

// I2C0 ist auf der rechten Seite frei (Nice!View nur links)
// SDA=P0.22(pin4), SCL=P0.24(pin5) - nRF52840 routing matrix erlaubt beliebige GPIOs
// Software I2C (bit-bang) - umgeht alle Hardware-TWIM-Konflikte
// SDA=P0.22(pin4), SCL=P0.24(pin5) als einfache GPIOs
/ {
    soft_i2c: i2c {
        compatible = "i2c-gpio";
        sda-gpios = <&gpio0 22 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;
        scl-gpios = <&gpio0 24 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad: trackpad@4a {
            compatible = "microchip,maxtouch";
            reg = <0x4a>;
            chg-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
            sensor-width = <156>;
            sensor-height = <91>;
            swap-xy;
            touch_threshold = <40>;
            gain = <3>;
            touch_hysteresis = <10>;
            charge_time = <27>;
        };
    };
};

/ {
    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
        input-processors = <&zip_xy_scaler 5 1>;
    };
};
