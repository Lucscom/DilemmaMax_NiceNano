// Dilemma Max - Right Side

#include "dilemma_max.dtsi"

// Disable UART0 (uses P0.06 as TX) to free pin for CHG interrupt
&uart0 {
    status = "disabled";
};

&default_transform {
    col-offset = <6>;
};

&right_encoder {
    status = "okay";
};

// I2C0 ist auf der rechten Seite frei (Nice!View nur links)
// SDA=P0.22(pin4), SCL=P0.24(pin5) - nRF52840 routing matrix erlaubt beliebige GPIOs
&pinctrl {
    trackpad_i2c_default: trackpad_i2c_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 22)>,
                    <NRF_PSEL(TWIM_SCL, 0, 24)>;
            bias-pull-up;
        };
    };
    trackpad_i2c_sleep: trackpad_i2c_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 22)>,
                    <NRF_PSEL(TWIM_SCL, 0, 24)>;
            low-power-enable;
        };
    };
};

&i2c1 {
    status = "okay";
    pinctrl-0 = <&trackpad_i2c_default>;
    pinctrl-1 = <&trackpad_i2c_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;
    // maxtouch-Treiber schreibt Registeradresse + Config-Block als zwei Messages ohne STOP,
    // der TWIM-Treiber kopiert das in einen internen Puffer (Default 16 Bytes, zu klein fuer T100)
    zephyr,concat-buf-size = <128>;

    trackpad: trackpad@4a {
        compatible = "microchip,maxtouch";
        reg = <0x4a>;
        chg-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
        // Procyon: 49.6 x 42 mm, Matrix 14 x 24 Leiterbahnen. Annahme: 14 X-Leitungen
        // ueber die 42-mm-Seite (Pitch 3.0), 24 Y-Leitungen ueber 49.6 mm (Pitch 2.1).
        // Nur fuer interne Filter des Chips relevant, nicht fuer die Cursor-Skalierung.
        sensor-width = <42>;
        sensor-height = <50>;
        // Procyon 42x50 belegt nur 10 X- und 12 Y-Leitungen. Mit x-lines/y-lines = 10/12
        // liefert der Chip aber keine Touch-Messages mehr (T37-Referenzen zeigen, dass er
        // dann Y0-5 und Y12-17 misst). Daher volle 14x24-Matrix; fuer relative Mausbewegung
        // spielt der ungenutzte Koordinatenbereich keine Rolle.
        // x-lines = <10>;
        // y-lines = <12>;
        // Temporaer: T37-Rohdaten ins Log (Referenzen einmal, Deltas alle 3s)
        diag-dump;
        swap-xy;
        // Empfindlichkeit: Modul-Defaults des Autors (touch_threshold 18, gain 4,
        // touch_hysteresis 8, charge_time 10), mit denen er das Procyon 42x50 betreibt.
        // Bei Ghost-Touches zuerst touch_threshold erhoehen, dann gain.
        // Mit 2 mm PLA-Abdeckung: zunaechst Modul-Defaults (18 / 8 / 10 / 4), Feintuning
        // nach dem T37-Delta-Dump. Bei zu schwachem Signal zuerst gain erhoehen.
        // Nur Mutual-Capacitance-Messung (Binding: "1 will always work"); mit 3 koennte
        // die Erkennung auf unkonfigurierten Self-Cap-Daten (T109/T111 leer) laufen.
        allowed_measurement_types = <1>;
    };
};

// Trackpad-Events an den Input-Split haengen (Peripheral -> Central)
&trackpad_split {
    device = <&trackpad>;
};
