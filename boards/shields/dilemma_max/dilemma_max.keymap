// Dilemma Max Keymap

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
// Override default scroll speed: 100 * 16ms/1000 = 1.6 units/tick (>= 1 required)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/dilemma_max/menu.h>

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            // tap-ms must be > trigger-period-ms (16ms) so the msc tick fires at least once
            tap-ms = <25>;
        };

        // Linker Encoder als Helligkeitsregler (Menue: Input > Knob > light)
        light_encoder: light_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&rgb_ug>, <&rgb_ug>;
        };

        // Linker Encoder im Einstellungsmenue: drehen waehlt den Eintrag
        menu_enc: menu_enc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&menu>, <&menu>;
        };

        // Bluetooth-Profile auf NAV + 1..5: tippen waehlt das Profil, 3 s halten waehlt es und
        // loescht seine Kopplung (&bt BT_CLR) -- danach wartet es auf einen neuen Rechner.
        // Das Loeschen passiert sofort und laesst sich nicht abbrechen.
        bt_sel_m: bt_sel_m {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL_CMD MACRO_PLACEHOLDER>;
        };
        bt_pair_m: bt_pair_m {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL_CMD MACRO_PLACEHOLDER>, <&bt BT_CLR>;
        };
        // Rechte Shift-Taste auf Ä. "balanced" statt des hold-preferred von &mt: Shift gilt
        // erst, wenn waehrend des Haltens eine andere Taste gedrueckt UND wieder losgelassen
        // wird (oder nach 200 ms). Beim schnellen Tippen ueberlappen sich Ä und der naechste
        // Buchstabe nur ("waehrend"), das bleibt damit ein Ä.
        shift_ae: shift_ae {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
        bt_ht: bt_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_pair_m>, <&bt_sel_m>;
        };
    };

    // NAV und WIN zusammen schalten die Windows-Varianten der NAV-Tasten dazu
    conditional_layers {
        compatible = "zmk,conditional-layers";
        nav_win {
            if-layers = <DM_LAYER_WIN DM_LAYER_NAV>;
            then-layer = <DM_LAYER_NAV_WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Die Reihenfolge der Layer ist in dt-bindings/dilemma_max/layers.h festgelegt:
        // BASE, WIN, KNOB_SCROLL, KNOB_LIGHT, NAV, NAV_WIN, MENU. Die Firmware schaltet WIN,
        // die beiden KNOB-Layer und MENU selbst.
        default_layer {
            display-name = "BASE";
            // Deutsches QWERTZ-Layout (OS auf Deutsch eingestellt)
            // ┌─────┬───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┬─────┐
            // │ ESC │ 1 │ 2 │ 3 │ 4 │ 5 │   │ 6 │ 7 │ 8 │ 9 │ 0 │ ß/?│
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │ TAB │ Q │ W │ E │ R │ T │   │ Z │ U │ I │ O │ P │  Ü  │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │LSFT │ A │ S │ D │ F │ G │   │ H │ J │ K │ L │ Ö │Ä/SFT│
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │LCTL │ Y │ X │ C │ V │ B │   │ N │ M │ , │ . │ - │  #  │
            // └─────┴───┼───┼───┼───┼───┤   ├───┼───┼───┼───┴───┴─────┘
            //           │MUT│ALT│GUI│NAV│   │BSP│SPC│RET│C_PP│
            //           └───┴───┴───┴───┘   └───┴───┴───┴────┘
            // Ä: tippen = Ä, halten = rechte Shift-Taste (&shift_ae)
            // Hinweis: Z/Y und Ö/Ä/Ü werden vom deutschen OS-Layout korrekt interpretiert
            // SEMI → Ö, SQT → Ä, LBKT → Ü (per deutschem HID-Mapping)
            bindings = <
                &kp ESC    &kp N1  &kp N2  &kp N3    &kp N4   &kp N5               &kp N6   &kp N7   &kp N8     &kp N9   &kp N0    &kp MINUS
                &kp TAB    &kp Q   &kp W   &kp E     &kp R    &kp T                &kp Y    &kp U    &kp I      &kp O    &kp P     &kp LBKT
                &kp LSHFT  &kp A   &kp S   &kp D     &kp F    &kp G                &kp H    &kp J    &kp K      &kp L    &kp SEMI  &shift_ae RSHFT SQT
                &kp LCTRL  &kp Z   &kp X   &kp C     &kp V    &kp B                &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                                  &kp C_MUTE &kp LALT &kp LGUI &mo DM_LAYER_NAV      &kp BSPC &kp SPACE &kp RET &kp C_PP
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder SCRL_DOWN SCRL_UP>;
        };

        // Layer DM_LAYER_WIN (1): aktiv, solange der gewaehlte Ausgang im Menue auf "win"
        // steht. Die Modifier liegen unter Windows wie auf dem Mac: Ctrl unten links, Alt und
        // die Windows-Taste (GUI) am Daumen - der Layer ueberschreibt deshalb im Moment keine
        // Taste. Er bleibt, weil an ihm die Windows-Varianten der NAV-Tasten (NAV_WIN) und
        // die Anzeige auf dem Display haengen, und als Platz fuer kuenftige Unterschiede.
        win_layer {
            display-name = "WIN";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans
            >;
        };

        // Layer DM_LAYER_KNOB_SCROLL (2) und DM_LAYER_KNOB_LIGHT (3): Funktion des linken
        // Encoders, gewaehlt im Menue unter Input > Knob. Die Firmware schaltet den passenden
        // Layer ein; ist keiner aktiv, regelt der Encoder die Lautstaerke (default_layer).
        // Der rechte Encoder bleibt, wie er ist. Mit NAV gilt wieder die Belegung von NAV.
        knob_scroll_layer {
            display-name = "SCROLL";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_encoder SCRL_DOWN SCRL_UP &scroll_encoder SCRL_DOWN SCRL_UP>;
        };

        knob_light_layer {
            display-name = "LIGHT";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&light_encoder RGB_BRD_CMD RGB_BRI_CMD &scroll_encoder SCRL_DOWN SCRL_UP>;
        };

        nav_layer {
            display-name = "NAV";
            // ┌─────┬───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┬─────┐
            // │     │BT0│BT1│BT2│BT3│BT4│   │   │   │   │   │   │     │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │     │   │   │   │   │   │   │   │   │ ↑ │   │ + │     │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │     │   │   │FN │MIS│ > │   │   │ ← │ ↓ │ → │   │     │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │     │   │   │   │   │ < │   │TOG│BRI│BRD│EFF│HUI│ HUD │
            // └─────┴───┼───┼───┼───┼───┤   ├───┼───┼───┼───┴───┴─────┘
            //           │   │   │   │   │   │   │   │   │
            //           └───┴───┴───┴───┘   └───┴───┴───┴───┘
            // BT0-4 = Bluetooth Profile 0-4: tippen = waehlen, 3 s halten = waehlen und Kopplung
            //         loeschen (Pairing-Modus fuer einen neuen Rechner)
            // FN    = Globe/Fn-Taste (Diktat)
            // MIS   = Mission Control (C_AC_DESKTOP_SHOW_ALL_WINDOWS)
            // TOG   = RGB Toggle, BRI/BRD = Helligkeit, EFF = Effekt, HUI/HUD = Farbe
            // Encoder druecken (Daumenreihe ganz links) = Einstellungsmenue oeffnen und schliessen
            bindings = <
                &trans      &bt_ht 0 0    &bt_ht 1 1    &bt_ht 2 2          &bt_ht 3 3                          &bt_ht 4 4  &trans  &trans    &trans    &trans     &trans  &trans
                &trans      &trans        &trans        &trans               &trans                              &trans        &trans  &trans    &kp UP   &trans     &kp RBKT  &trans
                &trans      &trans        &trans        &kp GLOBE            &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &kp LS(NUBS)  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
                &trans      &trans        &trans        &trans               &trans                              &kp NUBS  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD
                            &menu DM_MENU_OPEN  &trans        &trans               &trans                              &trans        &trans  &trans    &trans
            >;

            // Left encoder: volume | Right encoder: horizontal scroll (Maussimulation)
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder SCRL_LEFT SCRL_RIGHT>;
        };

        // Layer DM_LAYER_NAV_WIN (5): NAV unter Windows, schaltet sich ueber conditional_layers
        // von selbst ein. Ersetzt die Mac-Sondertasten: Diktat (Win+H) statt Globe,
        // Task-Ansicht (Win+Tab) statt Mission Control.
        nav_win_layer {
            display-name = "NAV";
            bindings = <
                &trans  &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &kp LG(H)   &kp LG(TAB)   &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans      &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans      &trans        &trans      &trans  &trans  &trans  &trans
            >;
        };

        // Layer DM_LAYER_MENU (6): aktiv, solange das Einstellungsmenue auf dem Display offen
        // ist. Oeffnen: NAV halten und den linken Encoder druecken. Im Menue: drehen = Eintrag
        // waehlen, druecken = Untermenue oeffnen oder Wert weiterschalten, NAV + druecken =
        // zurueck bzw. schliessen. Nach 20 s Pause geht es von selbst zu. Alle anderen Tasten
        // bleiben, wie sie sind.
        menu_layer {
            display-name = "MENU";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &menu DM_MENU_SELECT  &trans  &trans  &trans      &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&menu_enc DM_MENU_UP DM_MENU_DOWN &scroll_encoder SCRL_DOWN SCRL_UP>;
        };
    };
};
