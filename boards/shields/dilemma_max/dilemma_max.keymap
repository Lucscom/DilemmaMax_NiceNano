// Dilemma Max Keymap

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
// Override default scroll speed: 100 * 16ms/1000 = 1.6 units/tick (>= 1 required)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            // tap-ms must be > trigger-period-ms (16ms) so the msc tick fires at least once
            tap-ms = <25>;
        };

        // Bluetooth-Profile auf NAV + 1..5: tippen waehlt das Profil, 3 s halten waehlt es und
        // loescht seine Kopplung (&bt BT_CLR) -- danach wartet es auf einen neuen Rechner.
        // Das Loeschen passiert sofort und laesst sich nicht abbrechen.
        bt_sel_m: bt_sel_m {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL_CMD MACRO_PLACEHOLDER>;
        };
        bt_pair_m: bt_pair_m {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL_CMD MACRO_PLACEHOLDER>, <&bt BT_CLR>;
        };
        bt_ht: bt_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_pair_m>, <&bt_sel_m>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            // ┌─────┬───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┬─────┐
            // │ ESC │ 1 │ 2 │ 3 │ 4 │ 5 │   │ 6 │ 7 │ 8 │ 9 │ 0 │  =  │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │ TAB │ Q │ W │ E │ R │ T │   │ Y │ U │ I │ O │ P │  -  │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │LSFT │ A │ S │ D │ F │ G │   │ H │ J │ K │ L │ ; │  '  │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │LCTL │ Z │ X │ C │ V │ B │   │ N │ M │ , │ . │ / │  \  │
            // └─────┴───┼───┼───┼───┼───┤   ├───┼───┼───┼───┴───┴─────┘
            //           │MUT│ALT│GUI│MO1│   │BSP│SPC│RET│C_PP│
            //           └───┴───┴───┴───┘   └───┴───┴───┴────┘
            bindings = <
                &kp ESC    &kp N1  &kp N2  &kp N3    &kp N4   &kp N5               &kp N6   &kp N7   &kp N8     &kp N9   &kp N0    &kp EQUAL
                &kp TAB    &kp Q   &kp W   &kp E     &kp R    &kp T                &kp Y    &kp U    &kp I      &kp O    &kp P     &kp MINUS
                &kp LSHFT  &kp A   &kp S   &kp D     &kp F    &kp G                &kp H    &kp J    &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LCTRL  &kp Z   &kp X   &kp C     &kp V    &kp B                &kp N    &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                                  &kp C_MUTE &kp LALT &kp LGUI &mo 1      &kp BSPC &kp SPACE &kp RET &kp C_PP
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder SCRL_DOWN SCRL_UP>;
        };

        nav_layer {
            display-name = "NAV";
            // ┌─────┬───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┬─────┐
            // │     │BT0│BT1│BT2│BT3│BT4│   │   │   │   │   │   │     │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │     │   │   │   │   │   │   │   │   │ ↑ │   │   │     │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │     │   │   │FN │MIS│   │   │   │ ← │ ↓ │ → │   │     │
            // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
            // │     │   │   │   │   │   │   │TOG│BRI│BRD│EFF│HUI│ HUD │
            // └─────┴───┼───┼───┼───┼───┤   ├───┼───┼───┼───┴───┴─────┘
            //           │   │   │   │   │   │   │   │   │
            //           └───┴───┴───┴───┘   └───┴───┴───┴───┘
            // BT0-4 = Bluetooth Profile 0-4: tippen = waehlen, 3 s halten = waehlen und Kopplung
            //         loeschen (Pairing-Modus fuer einen neuen Rechner)
            // FN    = Globe/Fn-Taste (Diktat)
            // MIS   = Mission Control (C_AC_DESKTOP_SHOW_ALL_WINDOWS)
            // TOG   = RGB Toggle, BRI/BRD = Helligkeit, EFF = Effekt, HUI/HUD = Farbe
            bindings = <
                &trans      &bt_ht 0 0    &bt_ht 1 1    &bt_ht 2 2          &bt_ht 3 3                          &bt_ht 4 4    &trans  &trans    &trans    &trans     &trans  &trans
                &trans      &trans        &trans        &trans               &trans                              &trans        &trans  &trans    &kp UP    &trans     &trans  &trans
                &trans      &trans        &trans        &kp GLOBE            &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS   &trans        &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
                &trans      &trans        &trans        &trans               &trans                              &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD
                            &trans        &trans        &trans               &trans                              &trans        &trans  &trans    &trans
            >;

            // Left encoder: volume | Right encoder: horizontal scroll (Maussimulation)
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &scroll_encoder SCRL_LEFT SCRL_RIGHT>;
        };
    };
};
