config SHIELD_DILEMMA_MAX_LEFT
    def_bool $(shields_list_contains,dilemma_max_left)

config SHIELD_DILEMMA_MAX_RIGHT
    def_bool $(shields_list_contains,dilemma_max_right)

# Trackpad dimensions required by maxtouch-zephyr-module
# Der Treiber konfiguriert die volle 14x24-Chipmatrix, das Procyon 42x50 nutzt davon
# 10 X-Leitungen (4.2 mm Pitch) und 12 Y-Leitungen (4.13 mm Pitch). Mit 1024 Counts pro
# Achse ergibt das 17.4 Counts/mm entlang X, aber nur 10.3 entlang Y. Der Y-Bereich wird
# deshalb auf 1730 gestreckt, damit beide Achsen gleich schnell sind (ohne swap-xy
# entspricht LOGICAL_Y dem Chip-Y-Bereich).
config ZMK_TRACKPAD_LOGICAL_X
    int "Trackpad logical X resolution"
    default 1024

config ZMK_TRACKPAD_LOGICAL_Y
    int "Trackpad logical Y resolution"
    default 1730

config ZMK_TRACKPAD_PHYSICAL_X
    int "Trackpad physical X size (0.1mm units)"
    default 400

config ZMK_TRACKPAD_PHYSICAL_Y
    int "Trackpad physical Y size (0.1mm units)"
    default 600
